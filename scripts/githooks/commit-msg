#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
COMMIT_SUBJECT=$(printf "%s\n" "$COMMIT_MSG" | sed -n '1p')

# Ignore Git-generated subjects: merge, revert, fixup/squash (autosquash).
case "$COMMIT_SUBJECT" in
    Merge\ *|Revert\ \"*|Revert\ \'*|fixup!*|squash!*)
        echo "✅ Auto-generated commit message is ignored."
        exit 0
        ;;
esac

# Regex for Conventional Commits
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .+"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo "❌ Invalid commit message format."
    echo "   Please follow Conventional Commits (https://www.conventionalcommits.org/)"
    echo "   Example: feat: add user validation"
    exit 1
fi

echo "✅ Commit message format is valid."
exit 0
